{
  "manifest_version": 3,
  "name": "FrameDrop \u2014 Video & MP3",
  "version": "0.1.5",
  "description": "Save permitted YouTube videos and MP3 audio using a private local helper.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "minimum_chrome_version": "127",
  "author": "iniexe",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
